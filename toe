def write_portage_change(kind, lines, tag):
    """Write lines into /etc/portage/package.*; returns journal record."""
    base = os.path.join(PORTAGE_ETC, CHANGE_DIRS[kind])
    stamp = _dt.datetime.now().isoformat(timespec="seconds")
    header = f"# added by toe {stamp}: {tag}\n"
    body = header + "\n".join(lines) + "\n"
    if os.path.isfile(base):
        marker_b, marker_e = f"# >>> toe:{tag}:{stamp}", f"# <<< toe:{tag}:{stamp}"
        with open(base, "a") as f:
            f.write(f"\n{marker_b}\n{body}{marker_e}\n")
        return {"path": base, "mode": "block", "begin": marker_b, "end": marker_e}
    os.makedirs(base, exist_ok=True)
    safe = re.sub(r"[^\w.-]+", "_", tag)[:60]
    fn = os.path.join(base, "zz-toe-" + safe)
    mode = "append" if os.path.exists(fn) else "create"
    with open(fn, "a") as f:
        f.write(body)
    return {"path": fn, "mode": mode, "text": body}


