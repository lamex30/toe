            f.write("complete -c toe -f -n '__fish_use_subcommand' -a 'install remove search info update clean list why files owns history fix doctor undo alias reindex setup self-update'\n"
                    "complete -c toe -f -n '__fish_seen_subcommand_from install search info' -a '(toe _names)'\n"
                    "complete -c toe -f -n '__fish_seen_subcommand_from remove why files' -a '(toe _names --installed)'\n")
