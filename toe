def cmd_self_update(a, argv):
    """Download the latest toe from its GitHub repo, check it, and replace this file."""
    ensure_root(argv)
    banner("self-update")
    import urllib.request
    me = os.path.realpath(sys.argv[0])
    url = CONF["update_url"]
    ui.head(T("Скачиваю свежий toe", "Downloading the latest toe"))
    ui.step(ui.dim(url))
    try:
        with urllib.request.urlopen(url, timeout=30) as r:
            text = r.read().decode("utf-8")
    except Exception as e:
        ui.err(T(f"не получилось скачать: {e}", f"download failed: {e}"))
        return 1
    m = re.search(r'^VERSION = "([^"]+)"', text, re.M)
    if not text.startswith("#!/usr/bin/env python3") or not m:
        ui.err(T("скачалось что-то не то — это не toe", "that download isn't toe"))
        return 1
    try:
        compile(text, "toe", "exec")
    except SyntaxError as e:
        ui.err(T(f"в скачанном файле ошибка, не ставлю: {e}", f"the download is broken, not installing it: {e}"))
        return 1
    try:
        with open(me) as f:
            same = f.read() == text
    except OSError:
        same = False
    if same:
        ui.final = ui.c("1;32", T(f"toe {VERSION} уже самый свежий", f"toe {VERSION} is already the latest"))
        return 0
    tmp = me + ".new"
    with open(tmp, "w") as f:
        f.write(text)
    os.chmod(tmp, 0o755)
    os.replace(tmp, me)
    log(f"self-update {VERSION} -> {m.group(1)}")
    ui.final = ui.c("1;32", f"toe {VERSION} {ui.sym['arrow']} {m.group(1)}")
    return 0


