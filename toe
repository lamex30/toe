    return os.path.join(USER_CACHE_DIR, "index.json")


def upstream_ids(path):
    ids = []
    try:
        with open(path) as f:
            txt = f.read()
        for m in re.finditer(r'<remote-id type="[^"]+">([^<]+)</remote-id>', txt):
            ids.append(m.group(1).rsplit("/", 1)[-1])
    except OSError:
        pass
    return ids


def build_entries(portage, portdb, show=True):
    arch = portage.settings.get("ARCH", "amd64")
    repos_of = {}
    for repo in portdb.getRepositories():
        path = portdb.getRepositoryPath(repo)
        for cp in portdb.cp_all(trees=[path]):
            repos_of.setdefault(cp, []).append(repo)
    entries = []
    total = len(repos_of)
    for i, (cp, repos) in enumerate(sorted(repos_of.items())):
        if show and i % 250 == 0:
            ui.progress(i, total, T("индексирую дерево", "indexing tree"), cp)
        best = portdb.xmatch("bestmatch-visible", cp)
        cpvs = portdb.cp_list(cp)
        target = best or (cpvs[-1] if cpvs else None)
        desc = homepage = ""
        stable = False
        if target:
            try:
                desc, homepage, kw = portdb.aux_get(target, ["DESCRIPTION", "HOMEPAGE", "KEYWORDS"])
                stable = arch in kw.split()
            except Exception:
                pass
        ups = []
        for repo in repos:
            ups += upstream_ids(os.path.join(portdb.getRepositoryPath(repo), cp, "metadata.xml"))
        entries.append(Index.make_entry(cp, desc, homepage.split()[0] if homepage else "",
                                        repos, stable, bool(best), ups))
    if show:
        ui.progress_end()
    return entries


def binary_cps(portage):
    cps = set()
    pkgdir = portage.settings.get("PKGDIR", "/var/cache/binpkgs")
    files = glob.glob("/var/cache/binhost/**/Packages", recursive=True)
    files += glob.glob("/var/cache/edb/binhost/**/Packages", recursive=True)
    files.append(os.path.join(pkgdir, "Packages"))
    for fn in files:
        try:
            with open(fn, errors="replace") as f:
                for line in f:
                    if line.startswith("CPV: "):
                        cps.add(cpv_to_cp(line[5:].strip()))
        except OSError:
            pass
    return cps


def read_world():
    w = set()
    try:
        with open(WORLD_FILE) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#"):
                    w.add(line.split(":")[0])
    except OSError:
        pass
    return w


def load_index(force=False, show=True):
    portage = _portage()
    eroot = portage.settings["EROOT"]
    portdb = portage.db[eroot]["porttree"].dbapi
    vardb = portage.db[eroot]["vartree"].dbapi
    stamp = repo_stamp(portdb)
    data = None
    if not force:
        for p in (cache_path(), os.path.join(USER_CACHE_DIR, "index.json")):
            d = read_json(p, None)
            if d and d.get("stamp") == stamp and d.get("version") == VERSION:
                data = d
                break
    if data is None:
        if show:
            ui.head(T("Обновляю индекс пакетов", "Updating package index"))
        entries = build_entries(portage, portdb, show)
        data = {"version": VERSION, "stamp": stamp, "entries": entries}
        for p in (cache_path(write=True), os.path.join(USER_CACHE_DIR, "index.json")):
            try:
                write_json(p, data)
                break
            except OSError:
                continue
        if show:
            ui.ok(T(f"в индексе {len(entries)} пакетов", f"{len(entries)} packages indexed"))
    return Index(data["entries"], set(vardb.cp_all()), binary_cps(portage), read_world())


