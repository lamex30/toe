# ────────────────────────── emerge with progress ───────────────────────────
# Reads emerge's own ">>> Emerging (i of N) …" lines for the big picture and the
# package's build.log for the details: ebuild phase + [n/m] (ninja) or [ 42%] (cmake).

PHASE_MARKERS = [
    (">>> Unpacking source", "unpack"), (">>> Preparing source", "prepare"),
    (">>> Configuring source", "configure"), (">>> Compiling source", "compile"),
    (">>> Source compiled", "compiled"), (">>> Test phase", "test"),
    (">>> Install ", "install"), (">>> Completed installing", "installed"),
]
PHASE_WEIGHT = {"fetch": 0.02, "unpack": 0.05, "prepare": 0.08, "configure": 0.12, "compile": 0.18,
                "compiled": 0.86, "test": 0.86, "install": 0.88, "installed": 0.93, "merge": 0.95}
PHASE_NAME = {"fetch": ("загрузка", "fetch"), "unpack": ("распаковка", "unpack"),
              "prepare": ("подготовка", "prepare"), "configure": ("configure", "configure"),
              "compile": ("сборка", "compile"), "compiled": ("сборка", "compile"),
              "test": ("тесты", "test"), "install": ("установка", "install"),
              "installed": ("установка", "install"), "merge": ("слияние", "merge")}
NINJA_RE = re.compile(r"\[(\d+)/(\d+)\]")
CMAKE_RE = re.compile(r"\[\s*(\d{1,3})%\]")
EMERGE_EV_RE = re.compile(r">>> (Emerging binary|Emerging|Installing|Completed) \((\d+) of (\d+)\) (\S+)")
FAILED_RE = re.compile(r">>> Failed to (?:emerge|install) (\S+)")


def portage_tmpdir():
    if os.environ.get("PORTAGE_TMPDIR"):
        return os.environ["PORTAGE_TMPDIR"]
    try:
        import portage
        return portage.settings.get("PORTAGE_TMPDIR", "/var/tmp")
    except Exception:
        return "/var/tmp"


class Job:
    def __init__(self, cpv, binary):
        self.cpv = cpv.split("::")[0]
        self.repo = cpv.split("::")[1] if "::" in cpv else ""
        self.binary = binary
        self.phase = "fetch"
        self.n = self.m = None
        self.pct = None
        self.t0 = time.time()
        cat, pf = self.cpv.split("/", 1) if "/" in self.cpv else ("", self.cpv)
        self.log = os.path.join(portage_tmpdir(), "portage", cat, pf, "temp", "build.log")

    def poll(self):
        """update phase and counters from the tail of build.log"""
        if self.binary or self.phase == "merge":
            return
        try:
            with open(self.log, "rb") as f:
                f.seek(0, 2)
                size = f.tell()
                f.seek(max(0, size - 16384))
                tail = f.read().decode("utf-8", "replace")
        except OSError:
            return
        # the phase whose marker appears last in the log is the current one
        best = -1
        for marker, ph in PHASE_MARKERS:
            pos = tail.rfind(marker)
            if pos > best:
                best, cur = pos, ph
        if best >= 0:
            self.phase = cur
        if self.phase == "compile":
            m = None
            for m in NINJA_RE.finditer(tail):
                pass
            if m and int(m.group(2)) > 0:
                self.n, self.m = int(m.group(1)), int(m.group(2))
            else:
                c = None
                for c in CMAKE_RE.finditer(tail):
                    pass
                if c:
                    self.pct = int(c.group(1))

    def frac(self):
        if self.binary:
            return 0.9 if self.phase == "merge" else None
        base = PHASE_WEIGHT.get(self.phase, 0.1)
        if self.phase == "compile":
            if self.m:
                return 0.18 + 0.68 * self.n / self.m
            if self.pct is not None:
                return 0.18 + 0.68 * self.pct / 100
            return None            # compile progress unknown → bouncing bar
        return base

    def detail(self):
        name = T(*PHASE_NAME.get(self.phase, (self.phase, self.phase)))
        if self.binary:
            return T("скачиваю бинарь", "fetching binary") if self.phase != "merge" else name
        if self.phase == "compile" and self.m:
            return f"{name} [{self.n}/{self.m}]"
        if self.phase == "compile" and self.pct is not None:
            return f"{name} [{self.pct:3d}%]"
        return name


def fmt_time(sec):
    sec = int(max(0, sec))
    return f"{sec // 60}:{sec % 60:02d}"


def emerge_live(args):
    """Run emerge and draw the 6a timeline: service line per package,
    wget bar under running ones, total bar + eta at the bottom."""
    cmd = ["emerge"] + args
    if CONF["show_command"] or ui.verbose:
        ui.out(ui.dim("$ " + " ".join(cmd)))
    log("run: " + " ".join(cmd))
    if ui.verbose:
        return subprocess.call(cmd)
    env = dict(os.environ, NOCOLOR="true")
    p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, env=env)
    import select
    live = Live(ui)
    jobs = {}                 # cpv -> Job
    done = 0
    total = 0
    failed = []
    tail = []
    t0 = time.time()
    tick = 0
    buf = b""
    fd = p.stdout.fileno()

    def verb(job):
        return T("Скачиваю", "Fetching") if job.binary else T("Собираю", "Building")

    def region():
        lines = []
        for j in jobs.values():
            lines.append(ui.rail_prefix() + " " + ui.service(f"{verb(j)} {j.cpv}", "run", tick))
            fr = j.frac()
            if fr is None:
                b = ui.bar(0, 28, indeterminate_pos=tick)
                pc = "    "
            else:
                b = ui.bar(fr, 28)
                pc = f"{int(fr * 100):3d}%"
            el = fmt_time(time.time() - j.t0)
            lines.append(ui.rail_prefix() + "     " + b + " " + pc + "  " + ui.dim(f"{j.detail()}  {el}"))
        if total:
            part = sum((j.frac() or 0.5) for j in jobs.values())
            ov = min(1.0, (done + part) / total)
            el = time.time() - t0
            eta = (el / ov * (1 - ov)) if ov > 0.03 else None
            lines.append(ui.rail_prefix())
            lines.append(f"{ui.purple(ui.sym['tee'])}  {T('всего', 'total')} " + ui.bar(ov, 34, ui.lavender) +
                         " " + ui.bold(f"{int(ov * 100):3d}%"))
            info = f"{done}/{total} {ui.sym['dot']} {T('прошло', 'elapsed')} {fmt_time(el)}"
            if eta is not None:
                info += f" {ui.sym['dot']} eta {fmt_time(eta)}"
            lines.append(ui.rail_prefix() + "  " + ui.dim(info))
        return lines

    def handle(line):
        nonlocal done, total
        tail.append(line)
        del tail[:-80]
        m = EMERGE_EV_RE.search(line)
        if m:
            what, total = m.group(1), int(m.group(3))
            cpv = m.group(4).split("::")[0]
            if what in ("Emerging", "Emerging binary"):
                jobs[cpv] = Job(m.group(4), what == "Emerging binary")
            elif what == "Installing":
                j = jobs.get(cpv) or jobs.setdefault(cpv, Job(m.group(4), False))
                j.phase = "merge"
            elif what == "Completed":
                j = jobs.pop(cpv, None) or Job(m.group(4), False)
                done += 1
                live.above(ui.service(f"{verb(j)} {cpv}", "ok"))
            return
        f = FAILED_RE.search(line)
        if f:
            cpv = f.group(1).split("::")[0].rstrip(",")
            j = jobs.pop(cpv, None) or Job(cpv, False)
            failed.append(j)
            live.above(ui.service(f"{verb(j)} {cpv}", "fail"))

    try:
        while True:
            r, _, _ = select.select([fd], [], [], 0.12)
            if r:
                chunk = os.read(fd, 65536)
                if not chunk:
                    break
                buf += chunk
                while b"\n" in buf:
                    raw, buf = buf.split(b"\n", 1)
                    handle(raw.decode("utf-8", "replace").rstrip("\r"))
            tick += 1
            for j in jobs.values():
                if tick % 4 == 0:
                    j.poll()
            live.show(region())
    except KeyboardInterrupt:
        p.send_signal(signal.SIGINT)
    if buf:
        handle(buf.decode("utf-8", "replace"))
    rc = p.wait()
    live.stop()

    if rc != 0:
        for j in list(jobs.values()):
            failed.append(j)
            ui.out(ui.service(f"{verb(j)} {j.cpv}", "fail"))
        report_failure(failed, tail)
    return rc


def report_failure(failed, tail):
    ui.out()
    if not failed:
        ui.err(T("emerge завершился с ошибкой", "emerge failed"))
        for ln in [l for l in tail if l.strip()][-15:]:
            ui.out("  " + ui.dim(ln))
        return
    for j in failed:
        where = j.detail()
        ui.err(T(f"{j.cpv}: ошибка на этапе {where}", f"{j.cpv}: failed during {where}"))
        errs = []
        try:
            with open(j.log, errors="replace") as f:
                lines = f.readlines()[-400:]
            errs = [l.rstrip() for l in lines if re.search(r"\berror\b|Error |undefined reference|No such file", l)]
        except OSError:
            lines = []
        for e in (errs[-4:] or [l.rstrip() for l in lines[-6:]]):
            ui.out("    " + ui.dim(truncate_visible(e.strip(), ui.width - 10)))
        if os.path.exists(j.log):
            ui.warn(T("лог: ", "log: ") + ui.dim(j.log))
        ui.warn(T("попробуй: ", "try: ") + ui.bold(f"toe install ={j.cpv} --source --reinstall") +
                ui.dim("  (MAKEOPTS=-j1 " + T("если не хватает памяти", "if you ran out of RAM") + ")"))
    if os.access(SNAPSHOT_BIN, os.X_OK):
        ui.warn(T("если что-то сломалось — есть снимок: ", "if something broke there is a snapshot: ") + ui.bold("rollback"))


