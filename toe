# query words → (replacement variants, category hints)
SYNONYMS = [
    ("windowmanager", ["wm", ""], ["gui-wm", "x11-wm"]),
    ("waylandcompositor", ["wc", "wm", ""], ["gui-wm"]),
    ("compositor", ["wc", "wm", ""], ["gui-wm", "x11-wm"]),
    ("terminalemulator", ["term", ""], ["x11-terms", "gui-apps"]),
    ("terminal", ["term", ""], ["x11-terms", "gui-apps"]),
    ("webbrowser", [""], ["www-client"]),
    ("browser", [""], ["www-client"]),
    ("texteditor", [""], ["app-editors"]),
    ("editor", [""], ["app-editors"]),
    ("musicplayer", [""], ["media-sound"]),
    ("videoplayer", [""], ["media-video"]),
    ("player", [""], ["media-video", "media-sound"]),
    ("launcher", [""], ["gui-apps", "x11-misc"]),
    ("font", [""], ["media-fonts"]),
    ("fonts", [""], ["media-fonts"]),
    ("desktop", [""], []),
    ("app", [""], []),
]
# also short hint words that may stay as part of the name
HINT_TOKENS = {"wm": ["gui-wm", "x11-wm"], "wc": ["gui-wm"], "term": ["x11-terms"]}

JUNK_CAT_RE = re.compile(r"^(dev-(python|perl|ruby|lua|php|haskell|ml|java|dotnet|go|rust|lisp|tex|R)|"
                         r"acct-user|acct-group|virtual|perl-core|sec-keys|java-virtuals)$")
JUNK_PN_RE = re.compile(r"(-doc|-data|-libs?|-headers|-common|-bindings)$")


def query_variants(q):
    """Return (set of normalized variants, category hints)."""
    base = norm(q)
    variants = {base}
    hints = set()
    for word, reps, cats in SYNONYMS:
        new = set()
        for v in variants:
            if word in v:
                hints.update(cats)
                for r in reps:
                    nv = v.replace(word, r)
                    if nv:
                        new.add(nv)
        variants |= new
    for tok, cats in HINT_TOKENS.items():
        if base.endswith(tok):
            hints.update(cats)
    return variants, hints


def osa_distance(a, b):
    """Damerau-Levenshtein (optimal string alignment)."""
    la, lb = len(a), len(b)
    if la == 0 or lb == 0:
        return max(la, lb)
    prev2 = None
    prev = list(range(lb + 1))
    for i in range(1, la + 1):
        cur = [i] + [0] * lb
        for j in range(1, lb + 1):
            cost = 0 if a[i - 1] == b[j - 1] else 1
            cur[j] = min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + cost)
            if i > 1 and j > 1 and a[i - 1] == b[j - 2] and a[i - 2] == b[j - 1]:
                cur[j] = min(cur[j], prev2[j - 2] + 1)
        prev2, prev = prev, cur
    return prev[lb]


def jaro_winkler(a, b):
    if a == b:
        return 1.0
    la, lb = len(a), len(b)
    if not la or not lb:
        return 0.0
    md = max(la, lb) // 2 - 1
    am, bm = [False] * la, [False] * lb
    m = 0
    for i in range(la):
        for j in range(max(0, i - md), min(lb, i + md + 1)):
            if not bm[j] and a[i] == b[j]:
                am[i] = bm[j] = True
                m += 1
                break
    if not m:
        return 0.0
    t, k = 0, 0
    for i in range(la):
        if am[i]:
            while not bm[k]:
                k += 1
            if a[i] != b[k]:
                t += 1
            k += 1
    jaro = (m / la + m / lb + (m - t / 2) / m) / 3
    p = 0
    for x, y in zip(a[:4], b[:4]):
        if x != y:
            break
        p += 1
    return jaro + p * 0.1 * (1 - jaro)


def trigrams(s):
    s = f"  {s} "
    return {s[i:i + 3] for i in range(len(s) - 2)}


def similarity(q, name):
    if not q or not name:
        return 0.0
    dl = 1 - osa_distance(q, name) / max(len(q), len(name))
    jw = jaro_winkler(q, name)
    tq, tn = trigrams(q), trigrams(name)
    tri = len(tq & tn) / len(tq | tn)
    return 0.40 * jw + 0.35 * dl + 0.25 * tri


class Match:
    def __init__(self, entry, score, stage, note=""):
        self.e = entry
        self.score = score
        self.stage = stage
        self.note = note

    @property
    def cp(self):
        return self.e["cp"]


def junk(e, q):
    if e["cat"].split("-")[-1] in q:     # "python ..." in the query → dev-python is fine
        return False
    return bool(JUNK_CAT_RE.match(e["cat"]) or JUNK_PN_RE.search(e["pn"]))


def bonus(e, idx, hints):
    b = 0.0
    if e["cp"] in idx.binary:
        b += 0.05
    if e.get("stable"):
        b += 0.03
    if "gentoo" in e["repos"]:
        b += 0.03
    if hints and e["cat"] in hints:
        b += 0.08
    if not e.get("visible", True):
        b -= 0.04
    return b


class Resolution:
    """kind: exact | confirm | choose | none"""

    def __init__(self, kind, matches, query, atom_suffix=""):
        self.kind = kind
        self.matches = matches
        self.query = query
        self.suffix = atom_suffix


def split_version(q):
    """'python@3.13' -> ('python', ':3.13'), 'firefox=128' -> ('firefox', '=128')"""
    if "@" in q and not q.startswith("@"):
        name, slot = q.rsplit("@", 1)
        return name, ":" + slot
    m = re.match(r"^([^=<>]+?)=([\d][\w.*-]*)$", q)
    if m:
        return m.group(1), "=" + m.group(2)
    return q, ""


def resolve(query, idx, aliases=None, only_installed=False):
    aliases = aliases or {}
    name, suffix = split_version(query.strip())
    pool = [e for e in idx.entries if e["cp"] in idx.installed] if only_installed else idx.entries

    def ok(e):
        return (not only_installed) or e["cp"] in idx.installed

    # 1. exact atom cat/pn
    if "/" in name:
        e = idx.by_cp.get(name.lower())
        if e and ok(e):
            return Resolution("exact", [Match(e, 1.0, 1)], query, suffix)
        name = name.split("/", 1)[1]

    ql = name.lower()
    qn = norm(name)
    variants, hints = query_variants(name)

    # 2. exact package name
    hits = [e for e in idx.by_pn.get(ql, []) if ok(e)]
    if hits:
        good = [e for e in hits if not junk(e, qn)]
        if len(hits) == 1 or len(good) == 1:
            e = hits[0] if len(hits) == 1 else good[0]
            return Resolution("exact", [Match(e, 1.0, 2)], query, suffix)
        ms = sorted((Match(e, 0.99 + bonus(e, idx, hints) - (0.2 if junk(e, qn) else 0), 2) for e in hits),
                    key=lambda m: -m.score)
        return Resolution("choose", ms, query, suffix)

    # 3/4. aliases (curated, user, learned) incl. command names
    if qn in aliases:
        target = aliases[qn]
        e = idx.by_cp.get(target)
        if e and ok(e):
            return Resolution("exact", [Match(e, 1.0, 3, T(f"псевдоним «{name}»", f"alias «{name}»"))], query, suffix)

    # 5. normalized forms (separators, synonyms)
    nh = []
    for v in variants:
        nh += [e for e in idx.by_norm.get(v, []) if ok(e)]
    for e in pool:  # upstream repo names from metadata.xml
        if any(norm(u) in variants for u in e.get("upstream", [])):
            nh.append(e)
    uniq = {e["cp"]: e for e in nh}
    if uniq:
        cands = list(uniq.values())
        good = [e for e in cands if not junk(e, qn)]
        if len(cands) == 1 or len(good) == 1:
            e = cands[0] if len(cands) == 1 else good[0]
            return Resolution("exact", [Match(e, 0.97, 5, f"«{name}»")], query, suffix)
        ms = sorted((Match(e, 0.95 + bonus(e, idx, hints), 5) for e in cands), key=lambda m: -m.score)
        return Resolution("choose", ms[:8], query, suffix)

    # short queries: never fuzzy
    if len(qn) <= 3:
        return Resolution("none", fuzzy_candidates(qn, variants, hints, pool, idx, minlen=0)[:5], query, suffix)

    # 6/7. prefix/substring + fuzzy
    ms = fuzzy_candidates(qn, variants, hints, pool, idx)
    # 8. description search
    if not ms or ms[0].score < 0.6:
        ms = (ms + desc_search(name, pool, idx, hints))
        ms.sort(key=lambda m: -m.score)
    if not ms:
        return Resolution("none", [], query, suffix)
    top = ms[0]
    second = ms[1].score if len(ms) > 1 else 0
    if top.stage in (6, 7) and top.score >= CONF["fuzzy_threshold"] and top.score - second >= CONF["fuzzy_margin"]:
        return Resolution("confirm", ms[:5], query, suffix)
    return Resolution("choose", ms[:8], query, suffix)


def fuzzy_candidates(qn, variants, hints, pool, idx, minlen=4):
    res = []
    for e in pool:
        n = e["norm"]
        if junk(e, qn):
            pen = 0.12
        else:
            pen = 0.0
        best, stage = 0.0, 7
        for v in variants:
            if len(v) < 2:
                continue
            # prefix / substring with length ratio
            ratio = min(len(n), len(v)) / max(len(n), len(v))
            if (n.startswith(v) and ratio >= 0.6) or (v.startswith(n) and ratio >= 0.85):
                s = 0.80 + 0.15 * min(len(n), len(v)) / max(len(n), len(v))
                if s > best:
                    best, stage = s, 6
                continue
            if v in n and len(v) >= 4 and len(v) / len(n) >= 0.5:
                s = 0.72 + 0.15 * len(v) / len(n)
                if s > best:
                    best, stage = s, 6
                continue
            if len(v) < minlen:
                continue
            if abs(len(v) - len(n)) > max(3, len(v) // 2):
                continue
            if v[:2] != n[:2] and not (trigrams(v) & trigrams(n)) - {"  " + v[0], "  " + n[0]}:
                continue          # cheap prefilter: nothing in common
            s = similarity(v, n)
            if v[0] != n[0]:
                s -= 0.08
            if s > best:
                best, stage = s, 7
        if best >= 0.55:
            res.append(Match(e, best + bonus(e, idx, hints) - pen, stage))
    res.sort(key=lambda m: -m.score)
    return res[:20]


def desc_search(text, pool, idx, hints):
    toks = [t for t in re.split(r"\W+", text.lower()) if len(t) > 2]
    if not toks:
        return []
    res = []
    for e in pool:
        d = (e["desc"] + " " + e["pn"]).lower()
        hit = sum(1 for t in toks if t in d)
        if hit == len(toks):
            res.append(Match(e, 0.45 + 0.1 * hit / len(toks) + bonus(e, idx, hints), 8))
    res.sort(key=lambda m: -m.score)
    return res[:10]


# ─────────────────────────── remote overlays ───────────────────────────────
# Packages in overlays that aren't enabled yet, read from the overlays' official mirrors on GitHub
# (github.com/gentoo-mirror/<name>). Only the list of names is fetched: metadata/md5-cache has one
# file per version, so its file names are the overlay's packages. Cached for a day.

REMOTE_TTL = 24 * 3600
MIRROR = "https://github.com/gentoo-mirror/{}"
MIRROR_API = "https://api.github.com/repos/gentoo-mirror/{}/git/trees/{}"
MIRROR_RAW = "https://raw.githubusercontent.com/gentoo-mirror/{}/HEAD/metadata/md5-cache/{}"


def http_get(url, timeout=25):
    import urllib.request
    req = urllib.request.Request(url, headers={"User-Agent": f"toe/{VERSION}"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read()


def overlay_cpvs_git(name):
    """cat/pkg-ver names from a blobless shallow clone (about 1 MB for GURU)."""
    import tempfile
    if not shutil.which("git"):
        return None
    tmp = tempfile.mkdtemp(prefix="toe-")
    try:
        p = subprocess.run(["git", "clone", "--quiet", "--depth", "1", "--filter=blob:none", "--no-checkout",
                            MIRROR.format(name), tmp], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=120)
        if p.returncode != 0:
            return None
        p = subprocess.run(["git", "-C", tmp, "ls-tree", "-r", "--name-only", "HEAD", "metadata/md5-cache"],
                           stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=60)
        if p.returncode != 0:
            return None
        return [l[len("metadata/md5-cache/"):] for l in p.stdout.splitlines() if l.count("/") == 3]
    except (OSError, subprocess.SubprocessError):
        return None
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def overlay_cpvs_api(name):
    """The same list through the GitHub API, for systems without git (2 requests)."""
    try:
        meta = json.loads(http_get(MIRROR_API.format(name, "HEAD:metadata")))
        sha = next(t["sha"] for t in meta.get("tree", []) if t["path"] == "md5-cache")
        tree = json.loads(http_get(MIRROR_API.format(name, sha) + "?recursive=1"))
        return [t["path"] for t in tree.get("tree", []) if t["type"] == "blob" and "/" in t["path"]]
    except Exception:
        return None


def remote_overlay(name, refresh=False):
    """{cp: [versions]} for overlay NAME, from the cache when it is fresh; None when unreachable."""
    path = os.path.join(CACHE_DIR if is_root() else USER_CACHE_DIR, f"remote-{name}.json")
    d = read_json(path, None)
    if d and not refresh and time.time() - d.get("time", 0) < REMOTE_TTL:
        return d["cps"]
    cpvs = overlay_cpvs_git(name) or overlay_cpvs_api(name)
    if not cpvs:
        return d["cps"] if d else None      # offline: an old list is better than none
    cps = {}
    for cpv in cpvs:
        cps.setdefault(cpv_to_cp(cpv), []).append(cpv_version(cpv))
    try:
        write_json(path, {"time": time.time(), "cps": cps})
    except OSError:
        pass
    return cps


def remote_index(idx, refresh=False):
    """An Index of packages from search_overlays that aren't enabled here, or None."""
    entries = []
    enabled = {r for e in idx.entries for r in e["repos"]}
    for name in CONF["search_overlays"].split():
        if name in enabled:
            continue
        cps = remote_overlay(name, refresh)
        for cp, vers in (cps or {}).items():
            if cp not in idx.by_cp and "/" in cp:
                e = Index.make_entry(cp, repos=[name], visible=False)
                e["versions"] = vers
                entries.append(e)
    return Index(entries) if entries else None


def remote_details(e):
    """Description and keywords of a remote package's newest version, from its md5-cache file."""
    vers = sorted((v for v in e.get("versions", []) if not v.startswith("9999")), key=vkey) or e.get("versions", [])
    if not vers:
        return
    try:
        txt = http_get(MIRROR_RAW.format(e["repos"][0], f"{e['cp']}-{vers[-1]}"), timeout=10).decode("utf-8", "replace")
    except Exception:
        return
    for line in txt.splitlines():
        if line.startswith("DESCRIPTION="):
            e["desc"] = line.split("=", 1)[1]
        elif line.startswith("KEYWORDS="):
            e["stable"] = "amd64" in line.split("=", 1)[1].split()
    e["latest"] = vers[-1]


def portage_reload():
    """Make Portage read its configuration again (repos.conf after eselect repository enable)."""
    try:
        import portage
        portage._reset_legacy_globals()
        return True
    except Exception:
        return False


def enable_overlay(name):
    """eselect repository enable NAME + sync it. Returns a journal record, or None on failure."""
    if run(["eselect", "repository", "list"], capture=True)[0] != 0:
        ui.step(T("ставлю eselect-repository (нужен для оверлеев)", "installing eselect-repository (needed for overlays)"))
        if emerge_live(["--noreplace", "--getbinpkg", "app-eselect/eselect-repository"]) != 0:
            return None
    if not shutil.which("git"):
        ui.step(T("ставлю git (оверлеи синхронизируются через него)", "installing git (overlays sync with it)"))
        if emerge_live(["--noreplace", "--getbinpkg", "dev-vcs/git"]) != 0:
            return None
    rc, out = run(["eselect", "repository", "enable", name], capture=True)
    if rc != 0:
        ui.err(T(f"не получилось подключить {name}:", f"could not enable {name}:"))
        show_emerge_error(out, 8)
        return None
    ui.ok(T(f"оверлей {ui.bold(name)} подключён", f"overlay {ui.bold(name)} enabled"))
    ui.step(T(f"синхронизирую {name}…", f"syncing {name}…"))
    rc, out = run(["emaint", "sync", "-r", name], capture=True)
    if rc != 0:
        ui.err(T(f"синхронизация {name} не удалась:", f"syncing {name} failed:"))
        show_emerge_error(out, 8)
        run(["eselect", "repository", "disable", name], capture=True)
        return None
    log(f"overlay enabled: {name}")
    return {"mode": "overlay", "name": name, "path": f"repos.conf: {name}"}


def try_overlays(q, idx, local_res):
    """When Q isn't (exactly) in the enabled repos, look in search_overlays and offer to enable the
    overlay. Returns (cp, journal record) or None."""
    if not CONF["search_overlays"].strip():
        return None
    ui.step(T(f"ищу «{q}» в оверлеях ({CONF['search_overlays']})…", f"looking for «{q}» in overlays ({CONF['search_overlays']})…"))
    ridx = remote_index(idx)
    if not ridx:
        return None
    rres = resolve(q, ridx)
    if rres.kind == "none" or not rres.matches:
        return None
    if local_res.kind != "none" and rres.kind != "exact":
        return None              # a loose local match beats a loose remote one
    m = rres.matches[0]
    remote_details(m.e)
    name = m.e["repos"][0]
    ui.out(f"{ui.star_g()} " + T(f"нашла в оверлее {ui.bold(name)} (он не подключён): ", f"found in overlay {ui.bold(name)} (not enabled): ") +
           f"{pkg_line(m.e, ridx, False)}" + (f" {ui.dim(m.e['latest'])}" if m.e.get("latest") else ""))
    if m.e.get("desc"):
        ui.out("    " + ui.dim(m.e["desc"]))
    if rres.kind != "exact":
        m = choose_match(rres, ridx)
        if not m:
            return None
    ui.out("    " + ui.dim(T("оверлеи — сторонние репозитории; GURU ведут пользователи Gentoo под присмотром разработчиков",
                              "overlays are third-party repositories; GURU is run by Gentoo users, reviewed by developers")))
    if ui.yes:
        ui.warn(T(f"с -y оверлеи сами не подключаю: запусти без -y или сделай eselect repository enable {name}",
                  f"-y doesn't enable overlays on its own: run without -y, or eselect repository enable {name}"))
        return None
    if not ui.ask(T(f"Подключить {name} и поставить {m.cp}?", f"Enable {name} and install {m.cp}?"), True):
        return None
    rec = enable_overlay(name)
    return (m.cp, rec) if rec else None


