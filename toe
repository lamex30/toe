MERGE_LINE_RE = re.compile(r"^\[(?P<kind>binary|ebuild|nomerge|blocks|uninstall)\s+(?P<flags>[^\]]*)\]\s+(?P<cpv>\S+)(?P<rest>.*)$")
AUTOUNMASK_HDR = {
    "keyword": "The following keyword changes are necessary to proceed:",
    "use": "The following USE changes are necessary to proceed:",
    "license": "The following license changes are necessary to proceed:",
    "mask": "The following mask changes are necessary to proceed:",
}
ATOM_LINE_RE = re.compile(r"^[<>=~]*[\w+][\w+.-]*/[\w+][\w+.*-]*(::[\w-]+)?(\s+.*)?$")
IGNORED_BIN_HDR = "The following binary packages have been ignored due to non matching USE:"


class Plan:
    def __init__(self):
        self.items = []        # dicts: kind, flags, cpv, cp, old
        self.changes = {}      # kind -> [lines incl. comments]
        self.ignored_bin = []  # (cpv, flags)
        self.blockers = []
        self.raw = ""


CHANGE_USE_RE = re.compile(r"^-\s+(\S+?)(?:::\S+)?\s+\(Change USE:\s*([^)]*)\)")
NOISE_RE = re.compile(r"news items? need reading|Use eselect news read|These are the packages that would be merged|"
                      r"^Calculating dependencies|^Dependency resolution took|^\s*$")


def use_hints(out):
    """emerge sometimes suggests USE changes only as '- cat/pkg-1.0::repo (Change USE: +gtk3)'
    inside an error block. Take the first alternative of every such block."""
    hints, in_block = [], False
    for raw in out.splitlines():
        s = raw.strip()
        if s.startswith("!!! One of the following packages is required"):
            in_block = True
            continue
        m = CHANGE_USE_RE.match(s)
        if m and in_block:
            flags = [f[1:] if f.startswith("+") else f for f in re.findall(r"[+-][\w+.@-]+", m.group(2))]
            if flags:
                hints.append(f"{cpv_to_cp(m.group(1))} {' '.join(flags)}")
            in_block = False          # only the first alternative
    return list(dict.fromkeys(hints))


def show_emerge_error(out, limit=25):
    lines = [l for l in out.splitlines() if not NOISE_RE.search(l.strip())]
    for ln in lines[-limit:]:
        ui.out("   " + ui.dim(ln))


def parse_pretend(out):
    plan = Plan()
    plan.raw = out
    lines = out.splitlines()
    section = None
    for i, raw in enumerate(lines):
        line = raw.rstrip()
        s = line.strip()
        m = MERGE_LINE_RE.match(s)
        if m:
            section = None
            kind = m.group("kind")
            cpv = m.group("cpv")
            old = re.search(r"\[([^\]]+)\]", m.group("rest"))
            item = {"kind": kind, "flags": m.group("flags"), "cpv": cpv.split("::")[0],
                    "cp": cpv_to_cp(cpv), "repo": cpv.split("::")[1] if "::" in cpv else "",
                    "old": old.group(1).split("::")[0] if old else ""}
            if kind == "blocks":
                plan.blockers.append(s)
            else:
                plan.items.append(item)
            continue
        hdr = next((k for k, h in AUTOUNMASK_HDR.items() if s == h), None)
        if hdr:
            section = hdr
            plan.changes.setdefault(hdr, [])
            continue
        if s == IGNORED_BIN_HDR.strip() or s.endswith(IGNORED_BIN_HDR):
            section = "ignored"
            continue
        if section:
            if not s:
                # blank line ends a section only if the next non-blank isn't an entry
                nxt = next((l.strip() for l in lines[i + 1:] if l.strip()), "")
                if not (nxt.startswith("#") or ATOM_LINE_RE.match(nxt)):
                    section = None
                continue
            if s.startswith("(see") or s.startswith("Use --autounmask") or s.startswith("!!!") \
                    or s.startswith("NOTE:") or s.startswith("*"):
                if s.startswith("!!!") or s.startswith("Use --"):
                    section = None
                continue
            if section == "ignored":
                if s.startswith("="):
                    parts = s.split(None, 1)
                    plan.ignored_bin.append((parts[0][1:], parts[1] if len(parts) > 1 else ""))
                continue
            if s.startswith("#") or ATOM_LINE_RE.match(s):
                plan.changes[section].append(s)
            else:
                section = None
    hints = [h for h in use_hints(out) if h not in plan.changes.get("use", [])]
    if hints:
        plan.changes.setdefault("use", []).extend(["# suggested by emerge"] + hints)
    return plan


def prebuilt(it):
    """A plan item that compiles nothing: from the binhost, or a -bin ebuild (upstream's binary)."""
    return it["kind"] == "binary" or it["cp"].endswith("-bin")


def plan_rows(plan, idx):
    rows = []
    for it in plan.items:
        if it["kind"] in ("nomerge",):
            continue
        f = it["flags"]
        if "N" in f:
            st = ui.badge("new")
        elif "U" in f:
            st = ui.badge("upd")
        elif "D" in f:
            st = ui.badge("dn")
        elif it["kind"] == "uninstall":
            st = ui.badge("del")
        else:
            st = ui.badge("re")
        src = ui.badge("bin") if prebuilt(it) else ui.badge("src")
        cat, pn = it["cp"].split("/", 1) if "/" in it["cp"] else ("", it["cp"])
        ver = cpv_version(it["cpv"])
        old = (cpv_version(it["old"]) or it["old"]) if it["old"] else ""
        verstr = (ui.dim(old) + ui.dim(f" {ui.sym['arrow']} ") if old else "") + ui.green(ver)
        repo = ui.magenta("::" + it["repo"]) if it["repo"] and it["repo"] != "gentoo" else ""
        rows.append([st, src, ui.dim(cat + "/") + ui.bold(pn) + repo, verstr])
    return rows


