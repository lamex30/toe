def flatpak_search(q):
    if not shutil.which("flatpak"):
        return []
    rc, out = run(["flatpak", "search", "--columns=application,name", q], capture=True)
    res = []
    if rc == 0:
        for line in out.splitlines():
            parts = line.split("\t")
            if len(parts) >= 2 and "." in parts[0]:
                res.append((parts[0].strip(), parts[1].strip()))
    return res


def cmd_remove(a, argv):
    ensure_root(argv)
    banner("remove", " ".join(a.packages))
    idx = load_index(show=False)
    aliases = load_aliases()
    ui.head(T("Ищу среди установленных", "Looking among installed packages"))
    targets = []
    for q in a.packages:
        res = resolve(q, idx, aliases, only_installed=True)
        if res.kind == "none" or not res.matches:
            ui.out(T(f"   {ui.red(ui.sym['err'])} «{q}» не установлен", f"   {ui.red(ui.sym['err'])} «{q}» is not installed"))
            continue
        m = choose_match(res, idx)
        if not m:
            continue
        if m.cp in CRITICAL and not a.force:
            ui.err(T(f"{m.cp} — важная часть системы, не удаляю (если очень надо: --force)", f"{m.cp} is a core system package, not removing (if you really must: --force)"))
            continue
        targets.append(m.cp)
        ui.ok(f"{ui.badge('del')}  {pkg_line(m.e, idx, False)}")
    if not targets:
        return 1

    if a.force:
        ui.warn(T("--force: удаляю напрямую (emerge --unmerge), без проверки зависимостей!", "--force: removing directly (emerge --unmerge), no dependency checks!"))
        if not ui.ask(T("Точно?", "Are you sure?"), False):
            return 1
        take_snapshot("unmerge " + " ".join(targets))
        return run(["emerge", "--unmerge"] + targets)[0]

    rows = [[ui.badge("del"), ui.dim(t.split("/")[0] + "/") + ui.bold(t.split("/")[1])] for t in targets]
    ui.head(T(f"Удалить ({len(targets)})", f"Remove ({len(targets)})"))
    ui.table(rows)
    ui.out()
    if a.dry_run or a.explain:
        ui.out(ui.dim(f"   $ emerge --deselect {' '.join(targets)}"))
        ui.out(ui.dim(f"   $ emerge --depclean {' '.join(targets)}"))
        return 0
    if not ui.ask(T("Удалить?", "Remove?"), True):
        return 1
    take_snapshot("remove " + " ".join(targets))
    was_world = [t for t in targets if t in idx.world]
    if was_world:
        run(["emerge", "--deselect"] + was_world, capture=True)

    ui.head(T("Проверяю, что от них зависит", "Checking what depends on them"))
    rc, out = run(["emerge", "--pretend", "--depclean", "--color=n"] + targets, capture=True)
    removable, pulled = parse_depclean(out)
    blocked = [t for t in targets if t not in removable]
    for t in blocked:
        who = pulled.get(t, [])
        ui.warn(T(f"{ui.bold(t)} нужен другим пакетам", f"{ui.bold(t)} is needed by other packages") + (":" if who else ""))
        for w in who[:5]:
            ui.out("       " + ui.dim(w))
        if t in was_world:
            if ui.ask(T(f"Вернуть {t} в @world (как явно установленный)?", f"Put {t} back into @world (as explicitly installed)?"), True):
                run(["emerge", "--noreplace", t], capture=True)
            else:
                ui.out(ui.dim(T("     ок, он удалится сам, когда станет никому не нужен", "     ok, it will go away once nothing needs it")))
    go = [t for t in targets if t in removable]
    if not go:
        return 1
    rc = emerge_live(["--depclean"] + go)
    if rc == 0:
        if a.purge:
            purge_records(go)
        ui.ok(ui.bold(T("удалено: ", "removed: ")) + ", ".join(go))
        offer_orphans()
        after_ops()
    return rc


def parse_depclean(out):
    """-> (set of removable cps, {cp: [who pulls it in]})"""
    removable, pulled, cur = set(), {}, None
    for line in out.splitlines():
        s = line.strip()
        if s.startswith("All selected packages:"):
            for cpv in s.split(":", 1)[1].split():
                removable.add(cpv_to_cp(cpv))
            cur = None
            continue
        m = re.match(r"^(\S+/\S+) pulled in by:$", s)
        if m:
            cur = cpv_to_cp(m.group(1))
            pulled[cur] = []
            continue
        if cur is not None:
            if not s:
                cur = None
            else:
                pulled[cur].append(s)
    return removable, pulled


def purge_records(cps):
    j = read_json(JOURNAL, [])
    keep = []
    names = {c.split("/")[-1] for c in cps}
    for entry in j:
        if set(entry.get("packages", [])) and {p.split("/")[-1] for p in entry["packages"]} <= names:
            for r in entry["records"]:
                if revert_record(r):
                    ui.ok(T(f"убрала правку toe: {ui.dim(r['path'])}", f"removed toe change: {ui.dim(r['path'])}"))
        else:
            keep.append(entry)
    write_json(JOURNAL, keep)


def offer_orphans():
    rc, out = run(["emerge", "--pretend", "--depclean", "--color=n"], capture=True)
    m = re.search(r"Number to remove:\s+(\d+)", out)
    if m and int(m.group(1)) > 0:
        n = int(m.group(1))
        if ui.ask(T(f"Есть {n} ненужных пакетов-сирот. Убрать?", f"There are {n} orphaned packages. Remove them?"), False):
            emerge_live(["--depclean"])


def cmd_search(a, argv):
    idx = load_index()
    q = " ".join(a.query)
    res = resolve(q, idx, load_aliases())
    ms = res.matches[:]
    if res.kind in ("exact",):
        extra = fuzzy_candidates(norm(q), query_variants(q)[0], query_variants(q)[1], idx.entries, idx)
        seen = {m.cp for m in ms}
        ms += [m for m in extra if m.cp not in seen]
    ms += [m for m in desc_search(q, idx.entries, idx, set()) if m.cp not in {x.cp for x in ms}]
    ms = ms[:a.limit]
    ridx = remote_index(idx) if CONF["search_overlays"].strip() else None
    rms = []
    if ridx:
        rres = resolve(q, ridx)
        rms = [m for m in rres.matches if rres.kind != "none"][:5]
    if not ms and not rms:
        ui.out(T(f"{ui.red(ui.sym['err'])} ничего не нашла по «{q}»", f"{ui.red(ui.sym['err'])} nothing found for «{q}»"))
        return 1
    ui.head(f"«{q}» {ui.dim(ui.sym['dot'])} {len(ms) + len(rms)}")
    for m in ms:
        e = m.e
        ui.out(f"   {pkg_badges(e, idx)}  {pkg_line(e, idx, False)}")
        if e["desc"]:
            ui.out("        " + ui.dim(truncate_visible(e["desc"], ui.width - 10)))
    for m in rms:
        ui.out(f"   {ui.badge('ovl')}  {pkg_line(m.e, ridx, False)}  " +
               ui.dim(T("оверлей не подключён — toe install подключит", "overlay not enabled; toe install enables it")))
    return 0


