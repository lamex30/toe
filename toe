def cmd_install(a, argv):
    ensure_root(argv)
    banner("install", " ".join(a.packages))
    if not a.no_sync_check and check_sync():
        pass
    idx = load_index()
    aliases = load_aliases()
    ui.head(T("Ищу пакеты", "Looking up packages"))
    atoms, picked = [], []
    flatpak_wanted = []
    for q in a.packages:
        if q.startswith("@"):
            atoms.append(q)
            continue
        if re.match(r"^[<>=~]", q):
            atoms.append(q)
            continue
        res = resolve(q, idx, aliases)
        if res.kind != "exact" and not q.startswith(("@", "=", "<", ">", "~")):
            got = try_overlays(q, idx, res)
            if got:
                cp_new, rec = got
                # journaled right away, so toe undo disables the overlay even if this run stops here
                journal_add(" ".join(sys.argv), [rec], [cp_new])
                # Portage read repos.conf when toe started; it must read it again to see the overlay.
                portage_reload()
                idx = load_index(force=True)
                if cp_new not in idx.by_cp:
                    ui.step(T("перезапускаю toe, чтобы Portage увидел новый оверлей", "restarting toe so Portage sees the new overlay"))
                    sys.stdout.flush()
                    os.execv(sys.executable, [sys.executable, os.path.realpath(sys.argv[0])] + argv)
                res = Resolution("exact", [Match(idx.by_cp[cp_new], 1.0, 1)], q, "")
        if res.kind == "none" or not res.matches:
            ui.out(T(f"   {ui.red(ui.sym['err'])} «{q}» не нашла в подключённых репозиториях", f"   {ui.red(ui.sym['err'])} «{q}» not found in enabled repositories"))
            fp = flatpak_search(q) if CONF["flatpak_fallback"] != "never" else []
            if fp:
                ui.out(T(f"     {ui.badge('flat')} есть на Flathub: {ui.bold(fp[0][1])} {ui.dim(fp[0][0])}", f"     {ui.badge('flat')} available on Flathub: {ui.bold(fp[0][1])} {ui.dim(fp[0][0])}"))
                if ui.ask(T("Поставить через Flatpak?", "Install via Flatpak?"), False):
                    flatpak_wanted.append(fp[0][0])
            elif res.matches:
                ui.out("     " + ui.dim(T("ближе всего: ", "closest: ") + ", ".join(m.cp for m in res.matches[:3])))
            else:
                ui.out("     " + ui.dim(T("поищи в оверлеях: https://gpo.zugaina.org/ → eselect repository enable <оверлей>", "search overlays: https://gpo.zugaina.org/ → eselect repository enable <overlay>")))
            continue
        m = choose_match(res, idx)
        if not m:
            continue
        cp = m.cp
        # X vs X-bin: whenever a prebuilt -bin variant exists, say which one compiles and ask
        if not res.suffix:
            cp = choose_bin_variant(cp, idx, a)
            if cp is None:
                ui.step(T("пропускаю", "skipping"))
                continue
        if cp in idx.installed and not a.reinstall and not res.suffix:
            ui.ok(T(f"{pkg_line(idx.by_cp[cp], idx, False)} уже установлен", f"{pkg_line(idx.by_cp[cp], idx, False)} is already installed"))
            if cp not in idx.world:
                atoms.append(cp)   # adds to @world without rebuild thanks to --noreplace
            continue
        atom = cp + res.suffix if res.suffix.startswith(":") else (f"={cp}-{res.suffix[1:]}*" if res.suffix else cp)
        atoms.append(atom)
        picked.append(cp)
        note = f"{ui.dim(m.note)} {ui.dim(ui.sym['arrow'])} " if m.note else ""
        ui.ok(f"{note}{pkg_line(idx.by_cp[cp], idx, False)}  {pkg_badges(idx.by_cp[cp], idx)}")

    for app in flatpak_wanted:
        run(["flatpak", "install", "-y" if ui.yes else "--noninteractive", "flathub", app])
    if not atoms:
        return 0 if flatpak_wanted else 1

    flags = list(INSTALL_FLAGS)
    if a.reinstall:
        flags.remove("--noreplace")
    if a.bin:
        flags.append("--getbinpkgonly")
    if a.source:
        flags = [f for f in flags if f != "--getbinpkg"] + ["--getbinpkg=n", "--usepkg=n"]
    if a.oneshot:
        flags.append("--oneshot")

    records = []
    asked_bin = False
    for attempt in range(8):
        if attempt == 0:
            ui.head(T("Считаю зависимости", "Resolving dependencies"))
        rc, out = run(["emerge", "--pretend", "--color=n"] + flags +
                      ["--autounmask=y", "--autounmask-write=n", "--autounmask-license=y"] + atoms,
                      capture=True)
        plan = parse_pretend(out)
        if plan.changes.get("mask"):
            ui.err(T("пакет замаскирован (hardmask) — toe такое не снимает автоматически", "package is hard-masked — toe never unmasks that automatically"))
            for ln in plan.changes["mask"]:
                ui.out("   " + ui.dim(ln))
            ui.out(ui.dim(T("   причину смотри в package.mask профиля/репозитория; снять можно через /etc/portage/package.unmask", "   see the reason in the profile/repo package.mask; unmask via /etc/portage/package.unmask")))
            return 1
        need = {k: v for k, v in plan.changes.items() if v and k in CHANGE_DIRS}
        if plan.ignored_bin and not a.source and not asked_bin:
            asked_bin = True
            got = handle_ignored_bin(plan, a, " ".join(a.packages))
            if got:
                records += got
                continue
        if need:
            show_changes(need)
            if not ui.ask(T("Применить эти изменения в /etc/portage?", "Apply these changes to /etc/portage?"), True):
                return 1
            if a.dry_run or a.explain:
                ui.step(T("dry-run: в /etc/portage ничего не пишу", "dry-run: not writing to /etc/portage"))
                break
            tag = "-".join(sorted({cpv_to_cp(x).split("/")[-1] for x in picked})) or "deps"
            for kind, lines in need.items():
                records.append(write_portage_change(kind, lines, tag))
                ui.ok(T(f"записала {kind}: {ui.dim(records[-1]['path'])}", f"wrote {kind}: {ui.dim(records[-1]['path'])}"))
            continue
        if rc != 0 and not plan.items:
            ui.err(T("emerge не смог посчитать зависимости:", "emerge could not resolve dependencies:"))
            show_emerge_error(out, 30)
            if records:
                journal_add(" ".join(sys.argv), records, picked)
                ui.out(ui.dim(T("   правки /etc/portage сохранены; откатить: toe undo", "   /etc/portage changes kept; revert with: toe undo")))
            return 1
        break

    if plan.blockers:
        ui.warn(T("есть блокировки (конфликтующие пакеты):", "blockers (conflicting packages):"))
        for b in plan.blockers:
            ui.out("     " + ui.red(b))

    show_plan(plan, idx, picked)
    if a.dry_run or a.explain:
        ui.out(ui.dim("   $ emerge " + " ".join(flags + atoms)))
        return 0
    if not plan.items:
        ui.ok(T("ставить нечего", "nothing to install"))
        if records:
            journal_add(" ".join(sys.argv), records, picked)
        return 0
    if not ui.ask(T("Поехали?", "Proceed?"), True):
        if records and ui.ask(T("Откатить сделанные правки /etc/portage?", "Revert the /etc/portage changes?"), True):
            for r in records:
                revert_record(r)
        return 1
    if records:
        journal_add(" ".join(sys.argv), records, picked)
    if len(plan.items) > 3 or any(i["kind"] == "ebuild" for i in plan.items):
        take_snapshot("install " + " ".join(a.packages))
    ui.head(T("Устанавливаю", "Installing"))
    rc = emerge_live(flags + ["--quiet-build=y"] + atoms)
    if rc == 0:
        ui.final = ui.c("1;32", T(f"установлено пакетов: {len(plan.items)}", f"{len(plan.items)} packages installed"))
        after_ops()
    return rc


HEAVY = {"firefox", "chromium", "thunderbird", "libreoffice", "llvm", "clang", "rust", "qtwebengine",
         "webkit-gtk", "gcc", "spidermonkey", "nodejs", "openjdk", "ghc", "electron", "blender", "kicad"}


def bin_variants(cp, idx):
    """Prebuilt '-bin' packages for CP (same category first), e.g. www-client/firefox-bin."""
    cat, pn = cp.split("/", 1)
    if pn.endswith("-bin"):
        return []
    found = [e["cp"] for e in idx.by_pn.get(pn + "-bin", [])]
    return sorted(found, key=lambda c: (c.split("/")[0] != cat, c))


def will_compile(cp):
    """True when emerge would build CP from source, False when it comes from the binhost,
    None when that can't be told (masked, blockers, ...)."""
    rc, out = run(["emerge", "--pretend", "--nodeps", "--color=n", "--getbinpkg", "--binpkg-respect-use=y",
                   "--autounmask=y", "--autounmask-write=n", "--autounmask-license=y", cp], capture=True)
    for it in parse_pretend(out).items:
        if it["cp"] == cp:
            return it["kind"] == "ebuild"
    return None


def build_hint(cp):
    t = build_time_hint([cp]).get(cp)
    if t:
        return T(f"раньше собирался {t}", f"took {t} last time")
    if cp.split("/")[-1] in HEAVY:
        return T("это может занять полчаса и больше", "this can take half an hour or more")
    return ""


def choose_bin_variant(cp, idx, a):
    """Ask between CP and its prebuilt -bin variant; returns the chosen cp."""
    alts = bin_variants(cp, idx)
    if not alts:
        return cp
    alt = alts[0]
    if alt in idx.installed or cp in idx.installed:
        return alt if alt in idx.installed else cp
    if a.bin:
        return alt
    if a.source:
        return cp
    ui.step(T(f"у {cp} есть готовая версия {ui.bold(alt)}, проверяю, соберётся ли обычная…",
              f"{cp} has a prebuilt {ui.bold(alt)}; checking whether the regular one compiles…"))
    comp = will_compile(cp)
    bin_txt = T("готовый бинарник от разработчиков, без компиляции, ставится за пару минут",
                "the upstream prebuilt binary: no compiling, installs in a couple of minutes")
    if comp is False:
        reg_txt = T("тоже готовый: скачается с бинхоста Gentoo, с твоими USE-флагами",
                    "also prebuilt: downloads from the Gentoo binhost, with your USE flags")
        first = cp
    else:
        hint = build_hint(cp)
        reg_txt = (T("СОБИРАЕТСЯ ИЗ ИСХОДНИКОВ", "COMPILES FROM SOURCE") + (f" ({hint})" if hint else "")
                   if comp else T("не удалось проверить, возможно соберётся из исходников",
                                  "couldn't check; it may compile from source"))
        first = alt
    options = [(alt, bin_txt), (cp, reg_txt)]
    if first == cp:
        options.reverse()
    if ui.yes:
        choice = options[0][0]
        ui.step(T(f"беру {choice}", f"taking {choice}"))
        return choice
    items = [f"{ui.bold(c)}  {ui.dim(t) if c == alt else (ui.yellow(t) if comp else ui.green(t))}" for c, t in options]
    details = [idx.by_cp[c]["desc"] if c in idx.by_cp else "" for c, _ in options]
    i = ui.pick(T("Какую версию поставить?", "Which version to install?"), items, details)
    return None if i is None else options[i][0]


def handle_ignored_bin(plan, a, tag):
    ui.warn(T("бинарники есть, но с другими USE-флагами:", "binaries exist, but with different USE flags:"))
    for cpv, fl in plan.ignored_bin:
        ui.out(f"     {ui.bold(cpv_to_cp(cpv))}  {ui.dim(T('у бинарника:', 'binary has:'))} {ui.cyan(fl)}")
    if ui.yes or a.dry_run or a.explain:
        return []
    i = ui.pick(T("Как быть?", "What to do?"), [T("собрать со своими USE (дольше)", "build with your USE (slower)"),
                              T("взять бинарники и подстроить USE под них (быстро)", "use binaries and match USE to them (fast)")],
                [T("оставляю твои флаги как есть", "your flags stay as they are"), T("toe запишет package.use под флаги бинхоста; откат — toe undo", "toe writes package.use matching the binhost; revert: toe undo")])
    if i == 1:
        lines = [f"{cpv_to_cp(cpv)} {fl}" for cpv, fl in plan.ignored_bin if fl]
