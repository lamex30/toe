def pkg_line(e, idx, with_desc=True):
    cat, pn = e["cp"].split("/", 1)
    repo = "" if "gentoo" in e["repos"] else ui.magenta("::" + e["repos"][0])
    kw = "" if e.get("stable") else ui.yellow(" ~")
    s = f"{ui.dim(cat + '/')}{ui.bold(pn)}{repo}{kw}"
