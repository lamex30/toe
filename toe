def load_conf():
    conf = dict(DEFAULT_CONF)
    try:
        with open(CONF_FILE) as f:
            for line in f:
                line = line.split("#", 1)[0].strip()
                if "=" not in line:
                    continue
                k, v = (x.strip() for x in line.split("=", 1))
                if k not in conf:
                    continue
                d = DEFAULT_CONF[k]
                if isinstance(d, bool):
                    conf[k] = v.lower() in ("1", "true", "yes", "on")
                elif isinstance(d, float):
                    conf[k] = float(v)
                elif isinstance(d, int):
                    conf[k] = int(v)
                else:
                    conf[k] = v
    except OSError:
        pass
    return conf


CONF = load_conf()


def detect_lang():
    """TOE_LANG env > lang in toe.conf > LC_ALL > LC_MESSAGES > LANG (POSIX order)."""
    forced = os.environ.get("TOE_LANG") or (CONF["lang"] if CONF["lang"] != "auto" else "")
    if forced:
        return "ru" if forced.lower().startswith("ru") else "en"
    for var in ("LC_ALL", "LC_MESSAGES", "LANG"):
        v = os.environ.get(var, "")
        if v:
            return "ru" if v.lower().startswith("ru") else "en"
    return "en"


LANG = detect_lang()


def T(ru, en):
    """Pick the message for the current language (both versions live side by side)."""
    return ru if LANG == "ru" else en

# ───────────────────────────────── UI ──────────────────────────────────────
# Design "6a": a timeline rail on the left, OpenRC-style service lines
#   │ * Building gui-wm/mangowm-0.10.5 ........ [ ok ]
# wget-style bars under the running package and a total bar at the bottom.


class UI:
    # 256-color codes → 16-color equivalents for the Linux console
    TTY_COLORS = {"38;5;141": "35", "1;38;5;141": "1;35", "38;5;183": "1;35", "1;38;5;183": "1;35",
                  "1;38;5;255;48;5;61": "1;37;45", "38;5;60": "35", "38;5;245": "37"}
    # glyphs missing from console fonts (default8x16, Lat2-Terminus16 …)
    TTY_TEXT = str.maketrans({"—": "-", "–": "-", "−": "-", "→": "->", "…": "...", "♡": "",
                              "✓": "+", "✗": "x", "❯": ">", "•": "*", "▸": ">", "↑": "", "↓": "",
                              "╭": "┌", "╮": "┐", "╰": "└", "╯": "┘", "‘": "'", "’": "'"})
    SPIN_UNI = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]
    SPIN_ASCII = ["|", "/", "-", "\\"]

    def __init__(self):
        mode = CONF["color"]
        self.color = (mode == "always") or (mode == "auto" and sys.stdout.isatty()
                                            and os.environ.get("NO_COLOR") is None)
        utf = "utf" in (os.environ.get("LC_ALL", "") + os.environ.get("LC_CTYPE", "") + os.environ.get("LANG", "")).lower()
        sym_mode = CONF["symbols"]
        if sym_mode == "auto":
            if os.environ.get("TERM") == "linux":
                sym_mode = "console"
            elif utf and CONF["fancy"]:
                sym_mode = "unicode"
            else:
                sym_mode = "ascii"
        self.mode = sym_mode
        self.fancy = sym_mode == "unicode"
        self.yes = False
        self.quiet = False
        self.verbose = False
        self.width = shutil.get_terminal_size((80, 24)).columns
        self.rail = False          # inside a ┌ … └ timeline
        self.final = None          # message for the closing └ line
        self.t0 = time.time()

    # ── colors ──
    def fix(self, s):
        return s.translate(self.TTY_TEXT) if self.mode == "console" else s

    def fit(self, s):
        """One screen line: glyphs replaced first (the console's '...' is wider than '…'), then cut
        to the width, so a line never wraps and throws off an in-place redraw."""
        s = self.fix(s)
        w = self.width - 1
        if visible_len(s) > w:
            s = self.fix(truncate_visible(s, w - 2))
        return s

    def c(self, code, s):
        if not self.color:
            return s
        if self.mode == "console":
            code = self.TTY_COLORS.get(code, code)
        return f"\033[{code}m{s}\033[0m"

    def bold(self, s): return self.c("1", s)
    def dim(self, s): return self.c("2", s)
    def red(self, s): return self.c("31", s)
    def green(self, s): return self.c("32", s)
    def yellow(self, s): return self.c("33", s)
    def blue(self, s): return self.c("34", s)
    def magenta(self, s): return self.c("35", s)
    def cyan(self, s): return self.c("36", s)
    def purple(self, s): return self.c("38;5;141", s)
    def lavender(self, s): return self.c("38;5;183", s)
    pink = purple
    def star_g(self): return self.c("1;32", "*")
    def star_y(self): return self.c("1;33", "*")
    def star_r(self): return self.c("1;31", "*")
    def br(self, s): return self.c("1;34", s)          # OpenRC blue brackets

    @property
    def sym(self):
        if self.mode == "unicode":
            return dict(head="❯❯", ok="✓", err="✗", arrow="→", dot="·", sel="▸", heart="♡", ud="↑↓/",
                        v="│", top="┌", tee="├", end="└", hl="─", lead=".")
        if self.mode == "console":
            return dict(head=">>>", ok="+", err="x", arrow="->", dot="·", sel=">", heart="", ud="",
                        v="│", top="┌", tee="├", end="└", hl="─", lead=".")
        return dict(head=">>>", ok="+", err="x", arrow="->", dot=".", sel=">", heart="", ud="",
                    v="|", top="+", tee="+", end="+", hl="-", lead=".")

    def spinner(self, n):
        sp = self.SPIN_UNI if self.mode == "unicode" else self.SPIN_ASCII
        return sp[n % len(sp)]

    # ── raw output ──
    def _p(self, s, err=False):
        self._blank = ANSI_RE.sub("", s).strip() == self.sym["v"]
        print(self.fix(s), file=sys.stderr if err else sys.stdout, flush=True)

    def rail_prefix(self, kind="v"):
        return self.dim(self.sym[kind]) if kind == "v" else self.purple(self.sym[kind])

    def out(self, s=""):
        if self.rail:
            self._p(self.rail_prefix() + (" " + s if s else ""))
        else:
            self._p(s)

    # ── timeline ──
    def start(self, cmd, detail=""):
        """┌  [toe] install foo"""
        if self.quiet:
            return
        self.rail = True
        self.t0 = time.time()
        pill = self.c("1;38;5;255;48;5;61", " toe ") if self.color else "[toe]"
        self._p(f"{self.purple(self.sym['top'])}  {pill} {self.bold(cmd)}" + (f" {self.dim(detail)}" if detail else ""))
        self._p(self.rail_prefix())

    def close(self, rc):
        if not self.rail:
            return
        self.rail = False
        el = int(time.time() - self.t0)
        tm = self.dim(f"{el // 60}:{el % 60:02d}")
        if self.final:
            msg = self.final
        elif rc == 0:
            msg = self.c("1;32", T("готово", "done"))
        elif rc == 130:
            msg = self.yellow(T("отменено", "cancelled"))
        else:
            msg = self.c("1;31", T("не получилось", "failed"))
        heart = (" " + self.purple(self.sym["heart"])) if rc == 0 and self.sym["heart"] else ""
        self._p(f"{self.purple(self.sym['end'])}  {msg} {self.dim(self.sym['dot'])} {tm}{heart}")

    def head(self, s):
        """├  Section"""
        if self.rail:
            if not getattr(self, "_blank", False):
                self._p(self.rail_prefix())
            self._p(f"{self.purple(self.sym['tee'])}  {self.bold(s)}")
        else:
            self._p(f"{self.c('1;38;5;141', self.sym['head'])} {self.bold(s)}")

    def step(self, s):
        if not self.quiet:
            self.out(f"{self.star_g()} {s}")

    def ok(self, s):
        self.out(f"{self.star_g()} {s}")

    def warn(self, s):
        self.out(f"{self.star_y()} {s}")

    def err(self, s):
        if self.rail:
            self.out(f"{self.star_r()} {s}")
        else:
            self._p(f"{self.star_r()} {self.c('1;31', 'error:')} {s}", err=True)

    # ── OpenRC service line ──
    def lead_width(self):
        return max(30, min(self.width, 96) - 14)

    def service(self, text, state, spin=0):
        """* text ........ [ ok ]   state: ok | fail | wait | run | skip"""
        w = self.lead_width()
        text = truncate_visible(text, w - 3)
        dots = self.dim(self.sym["lead"] * max(2, w - visible_len(text)))
        star = {"fail": self.star_r(), "skip": self.star_y()}.get(state, self.star_g())
        tag = {"ok": self.c("1;32", "ok"), "fail": self.c("1;31", "!!"), "skip": self.c("1;33", "--"),
               "wait": self.dim(".."), "run": self.cyan(self.spinner(spin) + " ")}[state]
        return f"{star} {text} {dots} {self.br('[')} {tag} {self.br(']')}"

    # ── wget bar ──
    def bar(self, frac, width, fill_color=None, indeterminate_pos=None):
        """[=====>      ]   or bouncing [   <=>   ] when the fraction is unknown"""
        fill_color = fill_color or self.purple
        if indeterminate_pos is not None:
            span = max(1, width - 3)
            pos = indeterminate_pos % (2 * span)
            pos = pos if pos < span else 2 * span - pos
            inner = " " * pos + fill_color("<=>") + " " * (width - 3 - pos)
            return self.br("[") + inner + self.br("]")
        frac = max(0.0, min(1.0, frac))
        k = int(frac * width)
        if k >= width:
            body = "=" * width
        elif k > 0:
            body = "=" * (k - 1) + ">"
        else:
            body = ""
        return self.br("[") + fill_color(body) + " " * (width - len(body)) + self.br("]")

    def badge(self, kind):
        b = {
            "bin": ("1;32", "bin"), "src": ("1;33", "src"), "ovl": ("38;5;141", "ovl"),
            "inst": ("1;34", "inst"), "new": ("1;32", "N"), "upd": ("1;36", "U"),
            "re": ("2", "R"), "dn": ("1;33", "D"), "del": ("1;31", "-"), "flat": ("1;36", "flatpak"),
        }[kind]
        return self.c(b[0], b[1])

    def table(self, rows, aligns=None, indent="  "):
        if not rows:
            return
        n = len(rows[0])
        widths = [max(visible_len(r[i]) for r in rows) for i in range(n)]
        aligns = aligns or ["l"] * n
        for r in rows:
            cells = []
            for i, cell in enumerate(r):
                pad = widths[i] - visible_len(cell)
                cells.append(" " * pad + cell if aligns[i] == "r" else cell + " " * pad)
            self.out(indent + "  ".join(cells).rstrip())

    def box(self, title, lines):
        """kept for compatibility: rendered as a rail section"""
        self.head(title)
        for ln in lines:
            self.out("  " + ln)

    # ── questions ──
    def ask(self, question, default=True):
        if self.yes:
            return default
        hint = "[Y/n]" if default else "[y/N]"
        if self.rail:
            if not getattr(self, "_blank", False):
                self._p(self.rail_prefix())
            self._blank = False
            prompt = f"{self.purple(self.sym['tee'])}  {self.bold(question)} {self.dim(hint)} "
        else:
            prompt = f"{self.c('1;38;5;141', self.sym['head'])} {self.bold(question)} {self.dim(hint)} "
        try:
            ans = input(self.fix(prompt)).strip().lower()
        except EOFError:
            return default
        if not ans:
            return default
        return ans in ("y", "yes", "д", "да")

    # single-line progress (index building etc.)
    def progress(self, done, total, label, extra=""):
        if not sys.stdout.isatty() or self.quiet:
            return
        frac = 0 if total == 0 else done / total
        pre = (self.rail_prefix() + " ") if self.rail else ""
        txt = f"{pre}  {self.bar(frac, 24)} {self.bold(f'{int(frac * 100):3d}%')} {label}"
        if extra:
            txt += " " + self.dim(extra)
        sys.stdout.write("\r\033[K" + self.fit(txt))
        sys.stdout.flush()

    def progress_end(self):
        if sys.stdout.isatty() and not self.quiet:
            sys.stdout.write("\r\033[K")
            sys.stdout.flush()

    # ── picker ──
    def pick(self, title, items, details=None):
        if self.yes:
            return None
        if not (sys.stdin.isatty() and sys.stdout.isatty()):
            return self._pick_numbers(title, items)
        try:
            return self._pick_arrows(title, items, details)
        except Exception:
            return self._pick_numbers(title, items)

    def _pick_numbers(self, title, items):
        self.head(title)
        for i, it in enumerate(items, 1):
            self.out(f"  {self.bold(str(i)):>3}  {it}")
        try:
            ans = input(self.fix(f"{self.purple(self.sym['tee'])}  {self.bold(T('Номер (Enter — отмена):', 'Number (Enter to cancel):'))} ")).strip()
        except EOFError:
            return None
        if ans.isdigit() and 1 <= int(ans) <= len(items):
            return int(ans) - 1
        return None

    def _pick_arrows(self, title, items, details):
        import termios
        import tty
        fd = sys.stdin.fileno()
        old = termios.tcgetattr(fd)
        cur = 0
        n = len(items)
        lines_drawn = 0
        v = self.rail_prefix()

        def draw():
            nonlocal lines_drawn
            if lines_drawn:
                sys.stdout.write(f"\033[{lines_drawn}A")
            out = [v, f"{self.purple(self.sym['tee'])}  {self.bold(title)}"]
            for i, it in enumerate(items):
                mark = self.purple(self.sym["sel"]) if i == cur else " "
                out.append(f"{v}  {mark} {self.bold(it) if i == cur else it}")
            det = details[cur] if details else ""
            out.append(f"{v}    " + self.dim(det))
            out.append(f"{v}    " + self.dim(T(self.sym['ud'] + 'jk выбрать · Enter ок · q отмена',
                                               self.sym['ud'] + 'jk move · Enter pick · q cancel')))
            # every line fits the screen, or a wrapped one would break the redraw above
            sys.stdout.write("".join(f"\r\033[K{self.fit(l)}\n" for l in out))
            sys.stdout.flush()
            lines_drawn = len(out)

        sys.stdout.write("\033[?25l")
        try:
            tty.setcbreak(fd)
            draw()
            while True:
                ch = os.read(fd, 3)
                if ch in (b"\x1b[A", b"k"):
                    cur = (cur - 1) % n
                elif ch in (b"\x1b[B", b"j"):
                    cur = (cur + 1) % n
                elif ch in (b"\r", b"\n"):
                    return cur
                elif ch in (b"q", b"\x1b", b"\x03"):
                    return None
                elif ch.isdigit() and 1 <= int(ch) <= n:
                    cur = int(ch) - 1
                draw()
        finally:
            termios.tcsetattr(fd, termios.TCSADRAIN, old)
            sys.stdout.write("\033[?25h")
            sys.stdout.flush()


class Live:
    """A block of lines at the bottom of the screen that is redrawn in place;
    finished lines are printed above it permanently."""

    def __init__(self, ui):
        self.ui = ui
        self.drawn = 0
        self.last = []
        self.tty = sys.stdout.isatty()

    def _clear(self):
        if self.drawn and self.tty:
            sys.stdout.write(f"\033[{self.drawn}F\033[J")
        self.drawn = 0

    def show(self, lines):
        self.last = lines
        if not self.tty:
            return
        self._clear()
        sys.stdout.write("".join(self.ui.fit(l) + "\n" for l in lines))
        sys.stdout.flush()
        self.drawn = len(lines)

    def above(self, line):
        self._clear()
        self.ui.out(line)
        if self.tty:
            self.show(self.last)

    def stop(self):
        self._clear()
        self.last = []
        sys.stdout.flush()


ANSI_RE = re.compile(r"\033\[[0-9;?]*[A-Za-z]")


def visible_len(s):
    return len(ANSI_RE.sub("", s))


def truncate_visible(s, maxlen):
    if visible_len(s) <= maxlen:
        return s
    out, n, i = [], 0, 0
    while i < len(s) and n < maxlen - 1:
        m = ANSI_RE.match(s, i)
        if m:
            out.append(m.group())
            i = m.end()
            continue
        out.append(s[i])
        n += 1
        i += 1
    return "".join(out) + "…\033[0m"


