def write_completions(me):
    bash = """# bash completion for toe
_toe() {
  local cur=${COMP_WORDS[COMP_CWORD]} cmd=${COMP_WORDS[1]}
  if [ $COMP_CWORD -eq 1 ]; then
    COMPREPLY=($(compgen -W "install remove search info update clean list why files owns history fix doctor undo alias reindex setup self-update" -- "$cur")); return
  fi
  case $cmd in
    install|search|info) COMPREPLY=($(compgen -W "$(toe _names 2>/dev/null)" -- "$cur")) ;;
    remove|why|files) COMPREPLY=($(compgen -W "$(toe _names --installed 2>/dev/null)" -- "$cur")) ;;
  esac
}
complete -F _toe toe
"""
    for d in ("/usr/share/bash-completion/completions",):
        if os.path.isdir(d):
            with open(os.path.join(d, "toe"), "w") as f:
