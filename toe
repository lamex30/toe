CPV_RE = re.compile(r"^(?P<cp>[\w+][\w+.-]*/[\w+][\w+-]*?)-(?P<ver>\d[\w.]*(?:_(?:alpha|beta|pre|rc|p)\d*)*(?:-r\d+)?)$")


def cpv_to_cp(cpv):
    cpv = cpv.split("::", 1)[0].lstrip("=<>~")
    m = CPV_RE.match(cpv)
    return m.group("cp") if m else cpv


def cpv_version(cpv):
    m = CPV_RE.match(cpv.split("::", 1)[0].lstrip("=<>~"))
    return m.group("ver") if m else ""


def norm(s):
    return re.sub(r"[\s\-_.+]+", "", s.lower())


