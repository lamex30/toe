def revert_record(r):
    try:
        if r["mode"] == "overlay":
            return run(["eselect", "repository", "disable", r["name"]], capture=True)[0] == 0
        if r["mode"] == "create":
            os.remove(r["path"])
        elif r["mode"] == "append":
            with open(r["path"]) as f:
                txt = f.read()
            txt = txt.replace(r["text"], "")
            if txt.strip():
                with open(r["path"], "w") as f:
                    f.write(txt)
            else:
                os.remove(r["path"])
        elif r["mode"] == "block":
            with open(r["path"]) as f:
                txt = f.read()
            pat = re.compile(r"\n?" + re.escape(r["begin"]) + r".*?" + re.escape(r["end"]) + r"\n", re.S)
            with open(r["path"], "w") as f:
                f.write(pat.sub("", txt))
        return True
    except OSError as e:
        ui.warn(T(f"не смогла откатить {r['path']}: {e}", f"could not revert {r['path']}: {e}"))
        return False


