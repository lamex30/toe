def cmd_update(a, argv):
    ensure_root(argv)
    banner("update")
    take_snapshot("update")
    if not a.no_sync:
        ui.head(T("Синхронизирую репозитории", "Syncing repositories"))
        rc, out = run(["emaint", "sync", "-a"], capture=not ui.verbose)
        # rsync.gentoo.org rotates mirrors; a broken one fails Manifest
        # verification, and the next attempt usually lands on a good one.
        for _ in range(2):
            if rc == 0:
                break
            bad = re.findall(r"sync for repo: (\S+), returned code = [1-9]", out)
            if not bad:
                break
            ui.warn(T("не синхронизировалось: ", "sync failed for: ") + ", ".join(bad) +
                    T(" — пробую ещё раз (другое зеркало)", " — retrying (another mirror)"))
            rc, out = 0, ""
            for r in bad:
                r_rc, r_out = run(["emaint", "sync", "-r", r], capture=not ui.verbose)
                rc, out = rc or r_rc, out + r_out
        if rc != 0:
            ui.err(T("sync не удался", "sync failed"))
            lines = out.splitlines()
            log("sync output:\n" + out)
            errs = [l for l in lines if re.search(r"!!!|ERROR|[Ee]rror|mismatch|failed", l)]
            ui.out(ui.dim("\n".join((errs[-15:] + ["..."] if errs else []) + lines[-8:])))
            return rc
        ui.ok(T("репозитории свежие", "repositories are fresh"))
    idx = load_index()
    flags = ["--verbose", "--update", "--deep", "--newuse", "--with-bdeps=y", "--getbinpkg"]
    ui.head(T("Считаю обновления", "Calculating updates"))
    for attempt in range(8):
        rc, out = run(["emerge", "--pretend", "--color=n"] + flags +
                      ["--autounmask=y", "--autounmask-write=n", "--autounmask-license=y", "@world"], capture=True)
        plan = parse_pretend(out)
        need = {k: v for k, v in plan.changes.items() if v and k in CHANGE_DIRS}
        if not need or a.dry_run or a.explain:
            break
        show_changes(need)
        if not ui.ask(T("Применить эти изменения в /etc/portage?", "Apply these changes to /etc/portage?"), True):
            return 1
        recs = [write_portage_change(kind, lines, "update") for kind, lines in need.items()]
        for r in recs:
            ui.ok(T("записала ", "wrote ") + ui.dim(r["path"]))
        journal_add(" ".join(sys.argv), recs, [])
    if not plan.items:
        if rc != 0:
            ui.err(T("emerge не смог посчитать обновления:", "emerge could not calculate updates:"))
            show_emerge_error(out)
            return rc
        ui.final = ui.c("1;32", T("система актуальна", "system is up to date"))
        after_ops()
        return 0
    show_plan(plan, idx)
    if a.dry_run or a.explain:
        return 0
    if not ui.ask(T("Обновить?", "Update?"), True):
        return 1
    ui.head(T("Обновляю", "Updating"))
    rc = emerge_live(flags + ["--quiet-build=y", "@world"])
    if rc == 0:
        fix_preserved()
        kernel_hint()
        ui.final = ui.c("1;32", T("система обновлена", "system updated"))
        after_ops()
    return rc


def fix_preserved():
    reg = "/var/lib/portage/preserved_libs_registry"
    try:
        with open(reg) as f:
            if json.load(f):
                ui.head(T("Пересобираю пакеты со старыми библиотеками", "Rebuilding packages using old libraries"))
                emerge_live(["@preserved-rebuild"])
    except (OSError, ValueError):
        pass


def vkey(v):
    return [int(x) for x in re.findall(r"\d+", v)]


def newer_kernels():
    run_k = os.uname().release
    mods = os.listdir("/lib/modules") if os.path.isdir("/lib/modules") else []
    return sorted((m for m in mods if vkey(m) > vkey(run_k)), key=vkey)


def kernel_hint():
    newer = newer_kernels()
    if newer:
        ui.warn(T(f"установлено новое ядро ({newer[-1]}) — перезагрузись, чтобы на него перейти", f"new kernel installed ({newer[-1]}) — reboot to switch to it"))


def cmd_clean(a, argv):
