def log(msg):
    try:
        with open(LOG_FILE, "a") as f:
            f.write(f"{_dt.datetime.now().isoformat(timespec='seconds')} {msg}\n")
    except OSError:
        pass


def is_root():
    return os.geteuid() == 0


def ensure_root(argv):
    """Re-exec through sudo/doas for commands that change the system."""
    if is_root():
        return
    for tool in ("doas", "sudo"):
        p = shutil.which(tool)
        if p:
            os.execvp(p, [p, sys.executable, os.path.abspath(sys.argv[0])] + argv)
    ui.err(T("нужны права root, а sudo/doas не найдены", "root is required, but sudo/doas were not found"))
    sys.exit(1)


def run(cmd, capture=False, env_extra=None):
    env = dict(os.environ)
    env.update({"NOCOLOR": "true", "LC_ALL": "C"} if capture else {})
    if env_extra:
        env.update(env_extra)
    if CONF["show_command"] or ui.verbose:
        ui.out(ui.dim("   $ " + " ".join(cmd)))
    log("run: " + " ".join(cmd))
    if capture:
        p = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, env=env)
        return p.returncode, p.stdout
    return subprocess.call(cmd, env=env), ""


def read_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def write_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, ensure_ascii=False, indent=1)
    os.replace(tmp, path)


