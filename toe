def show_plan(plan, idx, picked=()):
    rows = plan_rows(plan, idx)
    if not rows:
        return
    nb = sum(1 for i in plan.items if prebuilt(i))
    ns = sum(1 for i in plan.items if i["kind"] == "ebuild" and not prebuilt(i))
