def _common(parser, suppress):
    d = {"default": argparse.SUPPRESS} if suppress else {}
    parser.add_argument("-y", "--yes", action="store_true", help=T("не задавать вопросов", "assume yes, no questions"), **d)
    parser.add_argument("-n", "--dry-run", action="store_true", help=T("только показать, что будет", "only show what would happen"), **d)
    parser.add_argument("--explain", action="store_true", help=T("показать команды emerge, ничего не делать", "print emerge commands, do nothing"), **d)
    parser.add_argument("-v", "--verbose", action="store_true", help=T("сырой вывод emerge", "raw emerge output"), **d)
    parser.add_argument("-q", "--quiet", action="store_true", help=T("поменьше текста", "less output"), **d)


def build_parser():
    p = argparse.ArgumentParser(prog="toe", description=T("дружелюбный пакетник для Gentoo (обёртка над emerge)", "friendly package manager for Gentoo (emerge wrapper)"))
    _common(p, False)
    p.add_argument("--version", action="version", version=f"toe {VERSION}")
    sp = p.add_subparsers(dest="cmd", metavar="command")
    common = argparse.ArgumentParser(add_help=False)
    _common(common, True)
    _add = sp.add_parser
    sp.add_parser = lambda *x, **k: _add(*x, parents=[common], **k)

    i = sp.add_parser("install", aliases=["i", "add"], help=T("установить пакеты", "install packages"))
    i.add_argument("packages", nargs="+")
    i.add_argument("--bin", action="store_true", help=T("только бинарники", "binary packages only"))
    i.add_argument("--source", action="store_true", help=T("собрать из исходников", "build from source"))
    i.add_argument("--reinstall", action="store_true")
    i.add_argument("--oneshot", action="store_true", help=T("не добавлять в @world", "do not add to @world"))
    i.add_argument("--no-sync-check", action="store_true")
    i.set_defaults(fn=cmd_install)

    r = sp.add_parser("remove", aliases=["rm", "uninstall"], help=T("удалить пакеты", "remove packages"))
    r.add_argument("packages", nargs="+")
    r.add_argument("--purge", action="store_true", help=T("убрать и правки toe в /etc/portage", "also drop toe changes in /etc/portage"))
    r.add_argument("--force", action="store_true", help=T("emerge --unmerge без проверок (опасно)", "emerge --unmerge without checks (dangerous)"))
    r.set_defaults(fn=cmd_remove)

    s = sp.add_parser("search", aliases=["s", "find"], help=T("поиск пакетов", "search packages"))
    s.add_argument("query", nargs="+")
    s.add_argument("-l", "--limit", type=int, default=15)
    s.set_defaults(fn=cmd_search)

    x = sp.add_parser("info", help=T("подробно о пакете", "package details"))
    x.add_argument("package")
    x.set_defaults(fn=cmd_info)

    u = sp.add_parser("update", aliases=["up", "upgrade"], help=T("sync + обновить систему", "sync + update the system"))
    u.add_argument("--no-sync", action="store_true")
    u.set_defaults(fn=cmd_update)

    sp.add_parser("clean", help=T("убрать ненужное", "remove what is not needed")).set_defaults(fn=cmd_clean)
    lst = sp.add_parser("list", aliases=["ls"], help=T("установленные пакеты", "installed packages"))
    lst.add_argument("-a", "--all", action="store_true")
    lst.set_defaults(fn=cmd_list)
    w = sp.add_parser("why", help=T("кому нужен пакет", "what needs a package"))
    w.add_argument("package")
    w.set_defaults(fn=cmd_why)
    f = sp.add_parser("files", help=T("файлы пакета", "package files"))
    f.add_argument("package")
    f.set_defaults(fn=cmd_files)
    o = sp.add_parser("owns", help=T("чей это файл/команда", "which package owns a file/command"))
    o.add_argument("path")
    o.set_defaults(fn=cmd_owns)
    h = sp.add_parser("history", help=T("история установок", "install history"))
    h.add_argument("package", nargs="?")
    h.set_defaults(fn=cmd_history)
    sp.add_parser("fix", help="preserved-rebuild + emaint --fix").set_defaults(fn=cmd_fix)
    sp.add_parser("doctor", help=T("проверить систему", "check the system")).set_defaults(fn=cmd_doctor)
    sp.add_parser("undo", help=T("откатить последние правки toe в /etc/portage", "revert the last toe changes in /etc/portage")).set_defaults(fn=cmd_undo)
    al = sp.add_parser("alias", help=T("свои псевдонимы", "your own aliases"))
    al.add_argument("action", choices=["add", "list"])
    al.add_argument("name", nargs="?")
    al.add_argument("atom", nargs="?")
    al.set_defaults(fn=cmd_alias)
    ri = sp.add_parser("reindex", help=T("пересобрать индекс поиска", "rebuild search index"))
    ri.set_defaults(fn=cmd_reindex)
    sp.add_parser("setup", help=T("поставить хук, конфиг, автодополнение", "install hook, config, completions")).set_defaults(fn=cmd_setup)
    sp.add_parser("self-update", aliases=["selfupdate"], help=T("обновить сам toe с GitHub", "update toe itself from GitHub")).set_defaults(fn=cmd_self_update)
    nm = sp.add_parser("_names")
    nm.add_argument("--installed", action="store_true")
    nm.set_defaults(fn=cmd_names)
    return p


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    p = build_parser()
    a = p.parse_args(argv)
    ui.yes, ui.verbose, ui.quiet = a.yes, a.verbose, a.quiet
    if not getattr(a, "fn", None):
        p.print_help()
        return 0
    if a.cmd == "alias" and a.action == "add" and not (a.name and a.atom):
        ui.err(T("использование: toe alias add <имя> <категория/пакет>", "usage: toe alias add <name> <category/package>"))
        return 2
    try:
        rc = a.fn(a, argv) or 0
    except KeyboardInterrupt:
        ui.progress_end()
        rc = 130
    ui.close(rc)
    return rc


if __name__ == "__main__":
    sys.exit(main())
