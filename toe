class Index:
    """Package metadata index (from Portage) + live installed/binary sets."""

    def __init__(self, entries, installed=None, binary=None, world=None):
        self.entries = entries                    # list of dicts
        self.by_cp = {e["cp"]: e for e in entries}
        self.by_pn = {}
        self.by_norm = {}
        for e in entries:
            self.by_pn.setdefault(e["pn"], []).append(e)
            self.by_norm.setdefault(e["norm"], []).append(e)
        self.installed = installed or set()
        self.binary = binary or set()
        self.world = world or set()

    @staticmethod
    def make_entry(cp, desc="", homepage="", repos=(), stable=False, visible=True, upstream=()):
        cat, pn = cp.split("/", 1)
        return {"cp": cp, "cat": cat, "pn": pn, "norm": norm(pn), "desc": desc,
                "homepage": homepage, "repos": list(repos), "stable": stable,
                "visible": visible, "upstream": list(upstream)}


def _portage():
    try:
        import portage  # noqa
        return portage
    except ImportError:
        ui.err(T("не найден модуль portage для этого python. Запусти toe тем python, "
               "под который собран portage (например: python3.13 /usr/bin/toe)", "portage module not found for this python. Run toe with the python "
               "portage is built for (e.g. python3.13 /usr/bin/toe)"))
        sys.exit(1)


def repo_stamp(portdb):
    parts = []
    for repo in portdb.getRepositories():
        path = portdb.getRepositoryPath(repo)
        for f in ("metadata/timestamp.chk", "metadata/timestamp.x", ".git/FETCH_HEAD", ""):
            p = os.path.join(path, f)
            if os.path.exists(p):
                parts.append(f"{repo}:{int(os.path.getmtime(p))}")
                break
    return "|".join(sorted(parts))


