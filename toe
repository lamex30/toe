def choose_match(res, idx):
    """Return chosen Match or None, with UI."""
    if res.kind == "exact":
        m = res.matches[0]
        if CONF["confirm_exact"] and not ui.ask(T(f"Это {m.cp}?", f"Is it {m.cp}?")):
            return None
        return m
    if res.kind == "confirm":
        m = res.matches[0]
        ui.out(T(f"   {ui.yellow('?')} «{res.query}» не найден точно. Похоже на:", f"   {ui.yellow('?')} «{res.query}» not found exactly. Did you mean:"))
        ui.out(f"     {pkg_badges(m.e, idx)}  {pkg_line(m.e, idx)}")
        if ui.yes:
            ui.err(T(f"«{res.query}»: неточное совпадение, в режиме --yes не ставлю. "
                   f"Укажи точно: toe install {m.cp}", f"«{res.query}»: inexact match, not installing in --yes mode. "
                   f"Be explicit: toe install {m.cp}"))
            return None
        if ui.ask(T("Это он?", "Is this it?"), True):
            learn(res.query, m.cp)
            return m
        res = Resolution("choose", res.matches, res.query, res.suffix)
    if res.kind == "choose" and res.matches:
        if ui.yes:
            ui.err(T(f"«{res.query}»: несколько вариантов ({', '.join(m.cp for m in res.matches[:4])}). Укажи точно.", f"«{res.query}»: several candidates ({', '.join(m.cp for m in res.matches[:4])}). Be explicit."))
            return None
        items = [f"{pkg_badges(m.e, idx)}  {pkg_line(m.e, idx, False)}" for m in res.matches]
        details = [m.e["desc"] or m.e["homepage"] for m in res.matches]
        i = ui.pick(T(f"Что из этого «{res.query}»?", f"Which one is «{res.query}»?"), items, details)
        if i is None:
            ui.step(T("пропускаю", "skipping"))
            return None
        learn(res.query, res.matches[i].cp)
        return res.matches[i]
    return None


def learn(query, cp):
    if norm(query) == norm(cp.split("/")[-1]) or not is_root():
        return
    d = read_json(LEARNED, {})
    d[query.lower()] = cp
    try:
        write_json(LEARNED, d)
    except OSError:
        pass


